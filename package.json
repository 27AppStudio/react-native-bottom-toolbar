{
  "name": "@27appstudio/react-native-bottom-toolbar",
  "version": "0.1.0",
  "description": "Native bottom toolbar for React Native: UIKit's toolbar on iOS (Liquid Glass on iOS 26) and a Material 3 floating toolbar on Android.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-bottom-toolbar-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./react-navigation": {
      "react-native-bottom-toolbar-source": "./src/react-navigation/index.ts",
      "types": "./lib/typescript/src/react-navigation/index.d.ts",
      "default": "./lib/module/react-navigation/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-bottom-toolbar-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "toolbar",
    "liquid-glass",
    "material3",
    "fab",
    "turbo-module",
    "react-navigation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/27AppStudio/react-native-bottom-toolbar.git"
  },
  "author": "27AppStudio <hello@27appstudio.com> (https://github.com/27AppStudio)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/27AppStudio/react-native-bottom-toolbar/issues"
  },
  "homepage": "https://github.com/27AppStudio/react-native-bottom-toolbar#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/react": "^19.2.0",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "4.30.0",
    "release-it": "^21.1.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@react-navigation/native": ">=7",
    "@react-navigation/native-stack": ">=7",
    "react": "*",
    "react-native": ">=0.82"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "BottomToolbarSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "ios": {
      "modulesProvider": {
        "BottomToolbar": "BottomToolbar"
      }
    },
    "android": {
      "javaPackageName": "com.bottomtoolbar"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "peerDependenciesMeta": {
    "@react-navigation/native": {
      "optional": true
    },
    "@react-navigation/native-stack": {
      "optional": true
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        },
        "infile": "CHANGELOG.md"
      }
    }
  }
}
